(ns chemical-ops.ledger-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [chemical-ops.ledger :as led]))

(defn- three-entries []
  (-> []
      (led/append (led/commit-entry {:plant-id :p :op :log-process-reading} :actor))
      (led/append (led/hold-entry {:hard? true :violations [{:rule :no-plant}]}))
      (led/append (led/commit-entry {:plant-id :p :op :schedule-maintenance} :human))))

(deftest an-intact-chain-verifies
  (let [l (three-entries)]
    (is (= {:ok? true :length 3} (led/verify l)))
    (is (= [0 1 2] (mapv :ledger/seq l)))
    (is (= 0 (:ledger/prev (first l))))
    (is (= (:ledger/hash (nth l 0)) (:ledger/prev (nth l 1))))
    (is (= (:ledger/hash (nth l 1)) (:ledger/prev (nth l 2))))))

(deftest the-empty-ledger-verifies
  (is (= {:ok? true :length 0} (led/verify []))))

(deftest a-modified-entry-breaks-the-chain-at-its-own-index
  (testing "changing content after the fact is detected where it happened"
    (let [l (three-entries)
          tampered (assoc-in l [1 :verdict :violations] [])]
      (is (= {:ok? false :length 3 :broken-at 1 :reason :hash-mismatch}
             (led/verify tampered))))))

(deftest a-dropped-entry-breaks-the-chain
  (testing "removing a middle entry is detected at the first entry after it"
    (let [l (three-entries)
          dropped (vec (concat (subvec l 0 1) (subvec l 2)))]
      (is (= :seq-mismatch (:reason (led/verify dropped))))
      (is (= 1 (:broken-at (led/verify dropped)))))))

(deftest a-reordered-ledger-breaks-the-chain
  (let [l (three-entries)
        swapped [(nth l 1) (nth l 0) (nth l 2)]]
    (is (false? (:ok? (led/verify swapped))))
    (is (= 0 (:broken-at (led/verify swapped))))))

(deftest an-entry-with-more-than-eight-keys-verifies
  (testing "nine keys is a hash-map, whose print order is not its insertion order; the chain must not depend on it"
    ;; escalate-entry has six keys of its own plus three :ledger/* keys = 9,
    ;; which is exactly the case that failed verify with :hash-mismatch on
    ;; 2026-09-11 before `canonical` existed. Keep it at the boundary.
    (let [e (led/escalate-entry {:plant-id :p} {:op :flag-anomalous-reading} {:confidence 0.9})
          l (led/append [] e)]
      (is (= 9 (count (first l))))
      (is (= {:ok? true :length 1} (led/verify l))))))

(deftest chain-hash-is-a-function-of-the-value-not-the-map-type
  (testing "the same content in two print orders hashes identically"
    ;; The array-map is built in the REVERSE of the hash-map's seq order, so
    ;; the two print differently and only a canonicalised hash agrees. The
    ;; first version of this test built both in the same order and stayed
    ;; green with `canonical` removed -- measured 2026-09-11 by mutation.
    (let [content (into {} (map (fn [i] [(keyword (str "k" i)) i]) (range 12)))
          as-array (apply array-map (mapcat identity (reverse (seq content))))
          as-hash (into (hash-map) content)]
      (is (= content as-array as-hash))
      (is (not= (pr-str as-array) (pr-str as-hash)) "the probe must actually differ in print order")
      (is (= (led/chain-hash 0 as-array) (led/chain-hash 0 as-hash))))))

(deftest commit-entries-say-who-approved
  (is (= :human (:approved-by (led/commit-entry {} :human))))
  (is (= :actor (:approved-by (led/commit-entry {} :actor))))
  (is (= :none (:approved-by (led/hold-entry {}))))
  (is (= :pending (:approved-by (led/escalate-entry {} {} {})))))

(deftest escalate-entry-carries-enough-to-explain-itself
  (let [e (led/escalate-entry {:plant-id :p1} {:op :flag-anomalous-reading} {:confidence 0.9})]
    (is (= :escalate (:disposition e)))
    (is (= :request-approval (:phase e)))
    (is (= :p1 (:plant-id e)))
    (is (= :flag-anomalous-reading (:op e)))
    (is (= 0.9 (:confidence e)))))

(deftest summary-has-one-line-per-entry
  (let [l (three-entries)]
    (is (= 3 (count (str/split-lines (led/summary l)))))))
