(ns chemical-ops.governor-test
  (:require [clojure.test :refer [deftest is testing]]
            [chemical-ops.governor :as gov]
            [chemical-ops.store :as store]))

(deftest hard-violations-unregistered-plant
  (testing "unregistered plant triggers hard violation"
    (let [proposal {:op :log-process-reading :effect :propose}
          request {:plant-id :nonexistent}
          s (store/mem-store {})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict))
      (is (not (:ok? verdict)))
      (is (seq (:violations verdict))))))

(deftest hard-violations-unverified-plant
  (testing "unverified plant triggers hard violation"
    (let [proposal {:op :log-process-reading :effect :propose}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? false}})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict))
      (is (not (:ok? verdict))))))

(deftest hard-violations-non-propose-effect
  (testing "non-:propose effect triggers hard violation"
    (let [proposal {:op :log-process-reading :effect :commit}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict))
      (is (not (:ok? verdict))))))

(deftest hard-violations-forbidden-ops
  (testing "reactor control is forbidden"
    (let [proposal {:op :reactor-control :effect :propose}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict))))
  (testing "chemical injection is forbidden"
    (let [proposal {:op :chemical-injection :effect :propose}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict))))
  (testing "process start is forbidden"
    (let [proposal {:op :process-start :effect :propose}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict))))
  (testing "emergency shutdown is forbidden"
    (let [proposal {:op :emergency-shutdown :effect :propose}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:hard? verdict)))))

(deftest escalation-anomalous-reading
  (testing "flag-anomalous-reading always escalates"
    (let [proposal {:op :flag-anomalous-reading :effect :propose :confidence 0.95}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (not (:hard? verdict)))
      (is (:escalate? verdict))
      (is (not (:ok? verdict))))))

(deftest escalation-low-confidence
  (testing "low confidence triggers escalation"
    (let [proposal {:op :log-process-reading :effect :propose :confidence 0.5}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (not (:hard? verdict)))
      (is (:escalate? verdict))
      (is (not (:ok? verdict))))))

(deftest ok-proposal
  (testing "valid proposal with high confidence is ok"
    (let [proposal {:op :log-process-reading :effect :propose :confidence 0.85}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (not (:hard? verdict)))
      (is (not (:escalate? verdict)))
      (is (:ok? verdict)))))

(deftest ok-schedule-maintenance
  (testing "schedule-maintenance proposal is ok with high confidence"
    (let [proposal {:op :schedule-maintenance :effect :propose :confidence 0.8}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:ok? verdict)))))

(deftest ok-shift-handover
  (testing "shift-handover proposal is ok with high confidence"
    (let [proposal {:op :coordinate-shift-handover :effect :propose :confidence 0.9}
          request {:plant-id :plant-1}
          s (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}})
          verdict (gov/check request nil proposal s)]
      (is (:ok? verdict)))))

;; ---- added 2026-09-11: the allowlist and the envelope --------------------
;; Each of these was measured to pass through `check` on 66aeb11.

(defn- verified-store []
  (store/mem-store {:plant-1 {:name "Plant 1" :status :operational :verified? true}}))

(defn- rules [verdict] (mapv :rule (:violations verdict)))

(deftest hard-on-undeclared-operation
  (testing "an op nobody declared holds -- the governor is an allowlist, not a denylist"
    (doseq [op [:open-relief-valve :override-interlock :vent-to-atmosphere
                :bypass-scrubber :delete-operation-record]]
      (let [verdict (gov/check {:plant-id :plant-1} nil
                               {:op op :effect :propose :confidence 0.95}
                               (verified-store))]
        (is (:hard? verdict) (str op))
        (is (not (:ok? verdict)) (str op))
        (is (not (:escalate? verdict)) (str op))
        (is (= [:undeclared-operation] (rules verdict)) (str op))))))

(deftest hard-on-every-reserved-operation-with-its-reason
  (doseq [op [:reactor-control :chemical-injection :process-start
              :emergency-shutdown :interlock-override :safety-system-activation]]
    (let [verdict (gov/check {:plant-id :plant-1} nil
                             {:op op :effect :propose :confidence 0.95}
                             (verified-store))]
      (is (:hard? verdict) (str op))
      (is (= [:no-reactor-control] (rules verdict)) (str op))
      (is (string? (:detail (first (:violations verdict)))) (str op)))))

(deftest hard-on-a-string-op
  (let [verdict (gov/check {:plant-id :plant-1} nil
                           {:op "log-process-reading" :effect :propose :confidence 0.95}
                           (verified-store))]
    (is (:hard? verdict))
    (is (= [:proposal-without-op] (rules verdict)))))

(deftest hard-on-confidence-out-of-range
  (testing "1.5 was admitted on 66aeb11"
    (let [verdict (gov/check {:plant-id :plant-1} nil
                             {:op :log-process-reading :effect :propose :confidence 1.5}
                             (verified-store))]
      (is (:hard? verdict))
      (is (= [:confidence-out-of-range] (rules verdict)))))
  (testing "a string threw ClassCastException on 66aeb11; now it holds"
    (let [verdict (gov/check {:plant-id :plant-1} nil
                             {:op :log-process-reading :effect :propose :confidence "high"}
                             (verified-store))]
      (is (:hard? verdict))
      (is (= [:confidence-out-of-range] (rules verdict))))))

(deftest confidence-exactly-at-the-floor-does-not-escalate
  (testing "the floor is a strict less-than; 0.7 commits, 0.69 escalates"
    (is (:ok? (gov/check {:plant-id :plant-1} nil
                         {:op :log-process-reading :effect :propose :confidence 0.7}
                         (verified-store))))
    (is (:escalate? (gov/check {:plant-id :plant-1} nil
                               {:op :log-process-reading :effect :propose :confidence 0.69}
                               (verified-store))))))

(deftest hard-and-escalating-holds-rather-than-escalates
  (testing "a reserved op with low confidence holds; nobody can be asked to approve it"
    (let [verdict (gov/check {:plant-id :plant-1} nil
                             {:op :reactor-control :effect :propose :confidence 0.1}
                             (verified-store))]
      (is (:hard? verdict))
      (is (not (:escalate? verdict))))))

(deftest hard-on-a-request-without-a-plant-id
  (let [verdict (gov/check {} nil
                           {:op :log-process-reading :effect :propose :confidence 0.95}
                           (verified-store))]
    (is (:hard? verdict))
    (is (= [:request-without-plant-id] (rules verdict)))))

