(ns chemical-ops.sim-test
  (:require [clojure.test :refer [deftest is testing]]
            [chemical-ops.sim :as sim]))

(deftest the-scenario-table-runs-clean-and-demonstrates-refusals
  (let [r (sim/run)]
    (is (:ok? r))
    (is (= (count sim/scenarios) (count (:results r))))
    (is (pos? (:refusals r)))
    (is (empty? (:mismatches r)))
    (is (empty? (:wrote-anyway r)))
    (is (empty? (:unlogged-escalations r)))
    (is (empty? (:unmarked-approvals r)))
    (is (empty? (:ledger-breaks r)))))

(deftest every-reserved-and-provenance-scenario-refuses
  (let [by-name (into {} (map (juxt :name identity) (:results (sim/run))))]
    (doseq [n [:unregistered-plant :unverified-plant :request-without-plant
               :undeclared-operation :reserved-reactor-control
               :reserved-emergency-shutdown :reserved-interlock-override]]
      (is (:refusal? (by-name n)) (str n))
      (is (not (:wrote? (by-name n))) (str n)))))

(deftest the-human-approved-scenario-writes-exactly-once-as-human
  (let [by-name (into {} (map (juxt :name identity) (:results (sim/run))))]
    (is (= {:records 1 :approved-by :human}
           (:approved-write (by-name :anomalous-reading-approved-by-human))))))

(deftest report-refuses-to-report-a-pass-with-no-refusals
  (testing "a run with zero refusals is not ok, and the report says why"
    (let [r (sim/run)
          none (assoc r :refusals 0 :ok? false)]
      (is (re-find #"REFUSING TO REPORT A PASS" (sim/report none)))
      (is (not (re-find #"REFUSING" (sim/report r))))
      (is (re-find #"PASS" (sim/report r))))))

(deftest a-table-without-refusing-scenarios-is-not-ok
  (testing "run over only the clean scenarios must come back :ok? false with refusals 0"
    (with-redefs [sim/scenarios (filterv #(= :commit (:expect %)) sim/scenarios)]
      (let [r (sim/run)]
        (is (zero? (:refusals r)))
        (is (false? (:ok? r)))
        (is (empty? (:mismatches r)))))))
